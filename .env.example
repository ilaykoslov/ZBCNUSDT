# ZBCNUSDT & PROSUSDT - Ortam Değişkenleri
# Kopyala: cp .env.example .env

# Sunucu Portu (varsayılan: 3456)
PORT=3456

# API timeout (ms)
API_TIMEOUT=15000

# Dashboard yenileme hızı (ms)
REFRESH_MS=15000

# Aktif sembol (ZBCNUSDT veya PROSUSDT)
ACTIVE_SYMBOL=ZBCNUSDT

# Sinyal eşikleri
BUY_THRESHOLD=12
SELL_THRESHOLD=-12

# CORS - İzin verilen originler (virgülle ayır)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API Key'ler (opsiyonel - gerekli ise)
# KUCOIN_API_KEY=your_key
# KUCOIN_API_SECRET=your_secret
# KUCOIN_API_PASSPHRASE=your_passphrase

# === PAPER TRADING AYARLARI ===
PAPER_TRADING_ENABLED=true
PAPER_TRADING_MODE=paper
PAPER_TRADING_MANUAL_APPROVAL=true
PAPER_TRADING_INITIAL_BALANCE=10000
PAPER_TRADING_MAX_POSITION_SIZE=0.1
PAPER_TRADING_STOP_LOSS_PCT=0.05
PAPER_TRADING_TAKE_PROFIT_PCT=0.10
PAPER_TRADING_FEE_RATE=0.001

# === RISK MANAGEMENT AYARLARI ===
RISK_MAX_POSITION_SIZE=0.1
RISK_MAX_DAILY_LOSS=0.05
RISK_MAX_OPEN_POSITIONS=3
RISK_DEFAULT_STOP_LOSS=0.05
RISK_DEFAULT_TAKE_PROFIT=0.10
RISK_RISK_REWARD_RATIO=2.0
RISK_MIN_CONFIDENCE=60
RISK_VOLATILITY_ADJUSTMENT=true

# === ALERT AYARLARI ===
ALERTS_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
EMAIL_ENABLED=false
EMAIL_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=